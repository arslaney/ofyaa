{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/analyze.js": {
      "maxDuration": 30
    },
    "api/parse-task.js": {
      "maxDuration": 15
    },
    "api/transcribe.js": {
      "maxDuration": 30
    },
    "api/send-daily-pushes.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/send-daily-pushes",
      "schedule": "0 6 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "app",
          "value": "1"
        }
      ],
      "destination": "/app/?app=1",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/studio/:path*",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://aqtqmvffcswxttecbwks.supabase.co; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
        }
      ]
    }
  ]
}
