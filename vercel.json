{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/analyze.js": {
      "maxDuration": 30
    },
    "api/parse-task.js": {
      "maxDuration": 15
    },
    "api/transcribe.js": {
      "maxDuration": 30
    },
    "api/send-daily-pushes.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/send-daily-pushes",
      "schedule": "0 6 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "app",
          "value": "1"
        }
      ],
      "destination": "/app/?app=1",
      "permanent": false
    }
  ]
}